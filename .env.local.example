# Supabase — get these from your project dashboard (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — NEVER expose this in the browser. Only used server-side.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# The full URL where the site is deployed (used for Open Graph and sitemap)
# GitHub Pages without custom domain:
NEXT_PUBLIC_SITE_URL=https://mateogsilvaa.github.io/lanedata
# With custom domain (lanedata.es):
# NEXT_PUBLIC_SITE_URL=https://lanedata.es

# Base path for GitHub Pages — MUST match the repo name.
# Leave empty if using a custom domain.
NEXT_PUBLIC_BASE_PATH=/lanedata
